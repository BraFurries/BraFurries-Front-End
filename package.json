{
  "name": "brafurries-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration production-api",
    "start:local-api": "ng serve --configuration local-api",
    "start:production-api": "ng serve --configuration production-api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:admin-logs": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.admin-logs.spec.json --include=**/bot-coddy-details.component.spec.ts --include=**/admin.service.spec.ts",
    "test:admin-partners": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.admin-partners.spec.json --include=**/admin.service.spec.ts --include=**/parceiros/**/*.spec.ts",
    "serve:ssr:brafurries-website": "node dist/brafurries-website/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.18",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.18",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.14",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.14",
    "express": "^4.22.3",
    "ngx-mask": "^19.0.7",
    "postcss": "^8.5.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.0",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.130",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": "^20.11.1 || >=22.0.0",
    "npm": ">=8.0.0"
  }
}
